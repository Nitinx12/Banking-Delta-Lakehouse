# sqlfluff configuration for Banking-Delta (postgres dialect).
#
# sql/ and tests/ are linted by `make sql-lint` (Makefile). This file records the
# project's SQL conventions and the lint baseline.
#
# Why a baseline: the SQL under sql/ was written and merged before the linter ran in
# CI, and AGENTS.md forbids rewriting merged SQL to satisfy a formatter. The rules
# listed in exclude_rules are therefore the ones the already-merged SQL does not
# satisfy; they are excluded as a documented baseline, not deleted. New SQL should
# still satisfy every rule not listed here.

[sqlfluff]
dialect = postgres
templater = raw
# Lint every procedure, including the large staging loaders.
large_file_skip_byte_limit = 0
# Baseline exclusions (see rule-by-rule notes below).
exclude_rules = LT01, LT02, LT03, LT05, LT08, LT09, LT12, LT14, AL01, AL03, AL05, AM03, AM04, AM05, AM06, AM09, CP03, CP05, RF02, RF04, ST05, ST07, ST09

# ---- layout.*  : the merged SQL uses free-form spacing/indentation and wide lines;
#                  re-flowing it would rewrite merged procedures (forbidden).
# LT01 spacing · LT02 indent · LT03 operators · LT05 long lines · LT08 cte newline
# LT09 select targets · LT12 end of file · LT14 keyword newline

# ---- aliasing.* : merged SQL mixes implicit/explicit aliases and unaliased literals.
# AL01 table alias · AL03 expression alias · AL05 unused alias

# ---- ambiguous.* : GROUP BY / ORDER BY / joins use ordinals and repeated columns in
#                   analysis queries; behaviour is intentional.
# AM03 order by · AM04 column count · AM05 join · AM06 column references · AM09 order-by-limit

# ---- capitalisation.* : functions and datatypes are written in both cases across the
#                        codebase; policies below pin keywords/identifiers/literals only.
# CP03 functions · CP05 types

# ---- references.* : business columns share names with keywords; qualification is not
#                    required in single-table reads.
# RF02 qualification · RF04 keywords

# ---- structure.* : USING(...) joins and subqueries in probes are intentional.
# ST05 subquery · ST07 using · ST09 join condition order

# ---- Pinned conventions (enforced where a rule is not excluded) ----

[sqlfluff:rules:capitalisation.keywords]
# AGENTS.md: uppercase SQL keywords.
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# Names are snake_case, created lower-case.
extended_capitalisation_policy = lower

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
# Datatypes are written upper-case (NUMERIC(18,2), TIMESTAMPTZ).
extended_capitalisation_policy = upper

[sqlfluff:rules:layout.long_lines]
# Wide column lists and procedure signatures do not fit 80 columns.
max_line_length = 120
