{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking-delta/reports/data/context.schema.json",
  "title": "Report context",
  "description": "Versioned contract for reports/data/context.json. The collector writes it, fixtures emulate it, the renderer consumes it. Breaking changes bump schema_version and update every fixture in the same PR (docs/REPORTING.md section 7).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "run",
    "steps",
    "tables",
    "dq",
    "errors",
    "freshness",
    "trends",
    "events",
    "verdict",
    "sections_failed"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "generated_at",
        "env",
        "git_sha",
        "airflow_version",
        "dag_id",
        "dag_run_id"
      ],
      "properties": {
        "kind": {"enum": ["daily", "incident", "weekly"]},
        "generated_at": {"type": "string"},
        "env": {"type": "string"},
        "git_sha": {"type": "string"},
        "airflow_version": {"type": "string"},
        "dag_id": {"type": "string"},
        "dag_run_id": {"type": "string"}
      }
    },
    "run": {
      "type": "object",
      "required": [
        "status",
        "duration_s",
        "total_tables",
        "successful_tables",
        "failed_tables"
      ],
      "properties": {
        "status": {"enum": ["RUNNING", "SUCCESS", "PARTIAL", "FAILED", "UNKNOWN"]},
        "duration_s": {"type": ["number", "null"], "minimum": 0},
        "total_tables": {"type": ["integer", "null"], "minimum": 0},
        "successful_tables": {"type": ["integer", "null"], "minimum": 0},
        "failed_tables": {"type": ["integer", "null"], "minimum": 0},
        "skipped_tables": {"type": ["integer", "null"], "minimum": 0},
        "started_at": {"type": ["string", "null"]},
        "ended_at": {"type": ["string", "null"]}
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "layer", "state", "duration_s", "attempts"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "layer": {"type": ["string", "null"]},
          "state": {"enum": ["ok", "warn", "bad", "idle"]},
          "duration_s": {"type": ["number", "null"], "minimum": 0},
          "attempts": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "table", "status", "rows_landed", "attempts"],
        "properties": {
          "layer": {"type": "string"},
          "table": {"type": "string"},
          "status": {
            "enum": ["RUNNING", "SUCCESS", "FAILED", "SKIPPED", "UNKNOWN"]
          },
          "rows_extracted": {"type": ["integer", "null"], "minimum": 0},
          "rows_landed": {"type": ["integer", "null"], "minimum": 0},
          "watermark_start": {"type": ["string", "null"]},
          "watermark_end": {"type": ["string", "null"]},
          "attempts": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "dq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "script_name", "status", "violation_count"],
        "properties": {
          "layer": {"type": "string"},
          "script_name": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "WARNING", null]},
          "violation_count": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "message", "timestamp"],
        "properties": {
          "category": {
            "enum": ["CONNECTION", "CONCURRENCY", "SPARK", "DATA", "UNKNOWN"]
          },
          "severity": {"enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]},
          "message": {"type": "string", "maxLength": 300},
          "timestamp": {"type": "string"},
          "table": {"type": ["string", "null"]},
          "layer": {"type": ["string", "null"]}
        }
      }
    },
    "freshness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table", "age_s", "window", "breached"],
        "properties": {
          "table": {"type": "string"},
          "age_s": {"type": ["number", "null"], "minimum": 0},
          "window": {"type": "string"},
          "breached": {"type": "boolean"},
          "severity": {"enum": ["WARNING", "ERROR", null]}
        }
      }
    },
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_key",
          "status",
          "duration_s",
          "rows_landed",
          "failed_tables",
          "dq_failures"
        ],
        "properties": {
          "run_key": {"type": "string"},
          "status": {
            "enum": ["RUNNING", "SUCCESS", "PARTIAL", "FAILED", "UNKNOWN"]
          },
          "duration_s": {"type": ["number", "null"], "minimum": 0},
          "rows_landed": {"type": ["integer", "null"], "minimum": 0},
          "failed_tables": {"type": ["integer", "null"], "minimum": 0},
          "dq_failures": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "rule",
          "severity",
          "layer",
          "subject",
          "category",
          "first_seen",
          "message",
          "impact",
          "runbook"
        ],
        "properties": {
          "event_id": {"type": "string"},
          "rule": {"type": "string", "pattern": "^R[0-9]{3}$"},
          "severity": {"enum": ["INFO", "MINOR", "MAJOR", "CRITICAL"]},
          "layer": {"type": ["string", "null"]},
          "subject": {"type": "string"},
          "category": {"type": "string"},
          "first_seen": {"type": "string"},
          "message": {"type": "string", "maxLength": 300},
          "impact": {"type": "string", "maxLength": 300},
          "runbook": {"type": ["string", "null"]}
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "label"],
      "properties": {
        "severity": {"enum": ["INFO", "MINOR", "MAJOR", "CRITICAL", "UNKNOWN"]},
        "label": {
          "enum": ["HEALTHY", "ATTENTION", "ACTION REQUIRED", "INCIDENT", "UNKNOWN"]
        }
      }
    },
    "sections_failed": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
