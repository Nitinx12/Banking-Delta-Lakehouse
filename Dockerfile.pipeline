FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN useradd --create-home --uid 1000 pipeline

WORKDIR /app

# Dependencies first so this layer is cached until requirements.txt changes.
COPY requirements.txt .
RUN pip install -r requirements.txt

# Only what main.py reads: itself, src/, scripts/ and sql/<schema>/00_master_load.sql.
# Secrets (.env files) are never copied; pass them at runtime instead.
COPY main.py ./
COPY src/ src/
COPY scripts/ scripts/
COPY sql/ sql/

# main.py adds src/ to sys.path itself; this also covers the child scripts.
ENV PYTHONPATH=/app:/app/src

USER pipeline

# Arguments after the image name go straight to main.py, e.g.
#   docker run --rm --env-file .env IMAGE --list
#   docker run --rm --env-file .env IMAGE --from staging-load
#   docker run --rm --env-file .env IMAGE --only marts-load --only marts-tests
ENTRYPOINT ["python", "main.py"]
