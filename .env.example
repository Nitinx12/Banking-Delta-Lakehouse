# =================================================
# Banking Delta Lakehouse Pipeline Environment Variables - EXAMPLE
# Copy this file to .env and fill in real values:
#   cp .env.example .env  (Windows: copy .env.example .env)
# =================================================

# --------------------------------------
# Environment Configuration
# --------------------------------------
TIME_FORMAT=%Y-%m-%d %H:%M:%S
TIMEZONE=Asia/Kolkata
ENVIRONMENT=development
LOG_LEVEL=INFO

# -------------------------------------------------
# Databricks configuration
# -------------------------------------------------
DATABRICKS_HOST=<your-databricks-host>
DATABRICKS_TOKEN=<your-databricks-token>
DATABRICKS_HTTP_PATH=<your-databricks-http-path>
DATABRICKS_SCHEMA_PUBLIC=public
DATABRICKS_MARTS_SCHEMA=marts
DATABRICKS_CATALOG=banking_transactions_db

# --------------------------------------
# publish_marts tuning (SQL connector bulk load)
#   PUBLISH_WORKERS          parallel statements + staging tables per mart
#   PUBLISH_WORKER_MIN_ROWS  tables smaller than this load on one connection
# --------------------------------------
PUBLISH_MAX_PARAMS=10000
PUBLISH_WORKERS=6
PUBLISH_WORKER_MIN_ROWS=50000
PUBLISH_FETCH_SIZE=10000

# ----------------------------------------------------
# MongoDB configuration
# ----------------------------------------------------
MONGO_URI=mongodb://localhost:27017/banking_support_db
MONGO_DB_NAME=banking_support_db
MONGO_PORT=27017

# ----------------------------------------------------
# PostgreSQL (warehouse) configuration
# ----------------------------------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DB=banking_warehouse
PG_USER=postgres
PG_PASS=changeme

# ----------------------------------------------------
# MySQL configuration
# ----------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<your-mysql-password>
MYSQL_DB=banking_core_db
MYSQL_URI=mysql://root:<your-mysql-password>@localhost:3306/banking_core_db

# ----------------------------------------------------
# Spark configuration (local extraction jobs)
# ----------------------------------------------------
SPARK_DRIVER_MEMORY=2g
SPARK_SHUFFLE_PARTITIONS=4

# ----------------------------------------------------
# Airflow configuration
# ----------------------------------------------------
AIRFLOW_HOST=localhost
AIRFLOW_PORT=8080
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<your-airflow-admin-password>
AIRFLOW_ADMIN_EMAIL=<your-admin-email>
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW__CORE__FERNET_KEY=<generate-with-python-cryptography-fernet-Fernet-generate_key>

# ----------------------------------------------------
# Gmail Alert / SMTP configuration
# ----------------------------------------------------
ALERT_EMAIL_TO=<your-alert-email>
ALERT_EMAIL_FROM=<your-sender-email>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail-address>
SMTP_PASSWORD=<your-gmail-app-password>
SMTP_MAIL_FROM=<your-gmail-address>
SMTP_STARTTLS=True
SMTP_SSL=False
# Airflow SMTP (maps to airflow.cfg [smtp])
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=<your-gmail-address>
AIRFLOW__SMTP__SMTP_PASSWORD=<your-gmail-app-password>
AIRFLOW__SMTP__SMTP_MAIL_FROM=<your-gmail-address>
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
