# Databricks SQL warehouse connection (dashboard reads the marts schema)
# Copy to secrets.toml and fill in real values. secrets.toml is git-ignored.

DATABRICKS_HOST = "dbc-XXXXXXXX.cloud.databricks.com"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
DATABRICKS_TOKEN = "dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
DATABRICKS_CATALOG = "main"
DATABRICKS_MARTS_SCHEMA = "marts"
