{
  "contract_version": 1,
  "name": "card_transactions",
  "description": "MongoDB card transactions. Incremental on _id (ObjectId).",
  "source": "mongodb_source",
  "source_schema": "banking_support_db",
  "source_table": "card_transactions",
  "target_schema": "raw",
  "target_table": "card_transactions",
  "business_key": [
    "_id"
  ],
  "load_strategy": "incremental",
  "incremental_column": "_id",
  "watermark_strategy": "objectid",
  "num_partitions": 2,
  "columns": [
    {
      "name": "_id",
      "type": "text",
      "nullable": false,
      "key": true
    },
    {
      "name": "card_txn_id",
      "type": "text",
      "nullable": true
    },
    {
      "name": "card_id",
      "type": "bigint",
      "nullable": true
    },
    {
      "name": "txn_date",
      "type": "date",
      "nullable": true
    },
    {
      "name": "merchant_category",
      "type": "text",
      "nullable": true
    },
    {
      "name": "amount",
      "type": "numeric(18,2)",
      "nullable": true
    },
    {
      "name": "is_fraud",
      "type": "integer",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "nullable": true
    }
  ],
  "quality": {
    "row_count": {
      "mode": "source_vs_landed_exact",
      "severity": "ERROR"
    },
    "freshness": {
      "mode": "max_loaded_at_within_window",
      "window": "PT24H",
      "compare": "landing_loaded_at",
      "severity": "WARNING"
    }
  },
  "owner": "banking-data-platform",
  "tags": [
    "incremental",
    "mongodb"
  ]
}
