{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://banking-delta/contracts/source-table.schema.json",
  "title": "Source table contract",
  "description": "Per-table landing contract. One file per source table under contracts/<source>/<table>.json. The source/target names, business key and load strategy must match audit.source_tables (sql/scripts/03_register_sources.sql).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "name",
    "description",
    "source",
    "source_schema",
    "source_table",
    "target_schema",
    "target_table",
    "business_key",
    "load_strategy",
    "columns",
    "quality"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 8
    },
    "source": {
      "enum": ["mongodb_source", "mysql_source", "databricks_source"]
    },
    "source_schema": {
      "type": "string",
      "minLength": 1
    },
    "source_table": {
      "type": "string",
      "minLength": 1
    },
    "target_schema": {
      "const": "raw"
    },
    "target_table": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "business_key": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^_?[a-z][a-z0-9_]*$" }
    },
    "load_strategy": {
      "enum": ["full", "incremental"]
    },
    "incremental_column": {
      "type": ["string", "null"]
    },
    "watermark_strategy": {
      "enum": ["timestamp", "numeric", "objectid", null]
    },
    "match_mode": {
      "enum": ["strict_gt", "inclusive_gte"]
    },
    "lookback": {
      "type": "string",
      "pattern": "^P(T[0-9]+[HMS])+$"
    },
    "num_partitions": {
      "type": "integer",
      "minimum": 1
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^_?[a-z][a-z0-9_]*$" },
          "type": { "$ref": "#/$defs/pg_type" },
          "nullable": { "type": "boolean" },
          "key": { "type": "boolean" },
          "pii": { "type": "boolean" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "freshness"],
      "properties": {
        "row_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "severity"],
          "properties": {
            "mode": { "enum": ["source_vs_landed_exact", "source_vs_landed_tolerant"] },
            "tolerance_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "severity": { "enum": ["ERROR", "WARNING"] }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "severity"],
          "properties": {
            "mode": { "enum": ["max_loaded_at_within_window", "none"] },
            "window": { "type": "string", "pattern": "^P(T[0-9]+[HMS])+$" },
            "compare": { "enum": ["landing_loaded_at", "source_incremental_column"] },
            "severity": { "enum": ["ERROR", "WARNING"] }
          }
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "load_strategy": { "const": "incremental" } } },
      "then": {
        "required": ["incremental_column", "watermark_strategy"],
        "properties": {
          "incremental_column": { "type": "string" },
          "watermark_strategy": { "enum": ["timestamp", "numeric", "objectid"] }
        }
      },
      "else": {
        "properties": {
          "incremental_column": { "type": "null" },
          "watermark_strategy": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "watermark_strategy": { "const": "objectid" } } },
      "then": {
        "properties": { "load_strategy": { "const": "incremental" } }
      }
    }
  ],
  "$defs": {
    "pg_type": {
      "description": "Postgres landing type after typing. Money is NUMERIC(18,2); times are timestamptz; Mongo dates are cast at landing.",
      "enum": [
        "bigint",
        "integer",
        "smallint",
        "numeric(18,2)",
        "numeric(5,2)",
        "double precision",
        "boolean",
        "text",
        "date",
        "timestamptz",
        "jsonb"
      ]
    }
  }
}
