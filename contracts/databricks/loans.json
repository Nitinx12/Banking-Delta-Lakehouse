{
  "contract_version": 1,
  "name": "loans",
  "description": "Databricks public loans, incremental on created_at.",
  "source": "databricks_source",
  "source_schema": "public",
  "source_table": "loans",
  "target_schema": "raw",
  "target_table": "loans",
  "business_key": [
    "loan_id"
  ],
  "load_strategy": "incremental",
  "incremental_column": "created_at",
  "watermark_strategy": "timestamp",
  "num_partitions": 4,
  "match_mode": "strict_gt",
  "columns": [
    {
      "name": "loan_id",
      "type": "bigint",
      "nullable": false,
      "key": true
    },
    {
      "name": "customer_id",
      "type": "bigint",
      "nullable": false
    },
    {
      "name": "branch_id",
      "type": "bigint",
      "nullable": false
    },
    {
      "name": "loan_type",
      "type": "text",
      "nullable": true
    },
    {
      "name": "loan_amount",
      "type": "numeric(18,2)",
      "nullable": true
    },
    {
      "name": "interest_rate",
      "type": "double precision",
      "nullable": true
    },
    {
      "name": "term_months",
      "type": "bigint",
      "nullable": true
    },
    {
      "name": "start_date",
      "type": "date",
      "nullable": true
    },
    {
      "name": "status",
      "type": "text",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "nullable": false
    }
  ],
  "quality": {
    "row_count": {
      "mode": "source_vs_landed_exact",
      "severity": "ERROR"
    },
    "freshness": {
      "mode": "max_loaded_at_within_window",
      "window": "PT24H",
      "compare": "landing_loaded_at",
      "severity": "WARNING"
    }
  },
  "owner": "banking-data-platform",
  "tags": [
    "incremental"
  ]
}
