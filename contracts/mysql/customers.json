{
  "contract_version": 1,
  "name": "customers",
  "description": "MySQL core customer master. Full load every run; staging dedupes on customer_id.",
  "source": "mysql_source",
  "source_schema": "banking_core_db",
  "source_table": "customers",
  "target_schema": "raw",
  "target_table": "customers",
  "business_key": ["customer_id"],
  "load_strategy": "full",
  "num_partitions": 4,
  "columns": [
    { "name": "customer_id", "type": "bigint", "nullable": false, "key": true },
    { "name": "customer_name", "type": "text", "nullable": false, "pii": true },
    { "name": "gender", "type": "text", "nullable": true },
    { "name": "date_of_birth", "type": "date", "nullable": true, "pii": true },
    { "name": "city", "type": "text", "nullable": true },
    { "name": "state", "type": "text", "nullable": true },
    { "name": "phone", "type": "text", "nullable": true, "pii": true },
    { "name": "email", "type": "text", "nullable": true, "pii": true },
    { "name": "occupation", "type": "text", "nullable": true },
    { "name": "annual_income", "type": "numeric(18,2)", "nullable": true },
    { "name": "join_date", "type": "date", "nullable": true },
    { "name": "credit_score", "type": "integer", "nullable": true },
    { "name": "created_at", "type": "timestamptz", "nullable": true },
    { "name": "updated_at", "type": "timestamptz", "nullable": true }
  ],
  "quality": {
    "row_count": { "mode": "source_vs_landed_exact", "severity": "ERROR" },
    "freshness": {
      "mode": "max_loaded_at_within_window",
      "window": "PT24H",
      "compare": "landing_loaded_at",
      "severity": "WARNING"
    }
  },
  "owner": "banking-data-platform",
  "tags": ["master-data", "pii"]
}
