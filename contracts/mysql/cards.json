{
  "contract_version": 1,
  "name": "cards",
  "description": "MySQL card master. Full load.",
  "source": "mysql_source",
  "source_schema": "banking_core_db",
  "source_table": "cards",
  "target_schema": "raw",
  "target_table": "cards",
  "business_key": [
    "card_id"
  ],
  "load_strategy": "full",
  "num_partitions": 4,
  "columns": [
    {
      "name": "card_id",
      "type": "bigint",
      "nullable": false,
      "key": true
    },
    {
      "name": "customer_id",
      "type": "bigint",
      "nullable": true
    },
    {
      "name": "account_id",
      "type": "bigint",
      "nullable": true
    },
    {
      "name": "card_type",
      "type": "text",
      "nullable": true
    },
    {
      "name": "issue_date",
      "type": "date",
      "nullable": true
    },
    {
      "name": "expiry_date",
      "type": "date",
      "nullable": true
    },
    {
      "name": "credit_limit",
      "type": "numeric(18,2)",
      "nullable": true
    },
    {
      "name": "status",
      "type": "text",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "nullable": true
    }
  ],
  "quality": {
    "row_count": {
      "mode": "source_vs_landed_exact",
      "severity": "ERROR"
    },
    "freshness": {
      "mode": "max_loaded_at_within_window",
      "window": "PT24H",
      "compare": "landing_loaded_at",
      "severity": "WARNING"
    }
  },
  "owner": "banking-data-platform",
  "tags": [
    "master-data"
  ]
}
