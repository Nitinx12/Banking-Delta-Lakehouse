{
  "contract_version": 1,
  "name": "branches",
  "description": "MySQL branch master. Full load.",
  "source": "mysql_source",
  "source_schema": "banking_core_db",
  "source_table": "branches",
  "target_schema": "raw",
  "target_table": "branches",
  "business_key": [
    "branch_id"
  ],
  "load_strategy": "full",
  "num_partitions": 4,
  "columns": [
    {
      "name": "branch_id",
      "type": "bigint",
      "nullable": false,
      "key": true
    },
    {
      "name": "branch_name",
      "type": "text",
      "nullable": true
    },
    {
      "name": "city",
      "type": "text",
      "nullable": true
    },
    {
      "name": "state",
      "type": "text",
      "nullable": true
    },
    {
      "name": "opened_date",
      "type": "date",
      "nullable": true
    },
    {
      "name": "ifsc_code",
      "type": "text",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "nullable": true
    }
  ],
  "quality": {
    "row_count": {
      "mode": "source_vs_landed_exact",
      "severity": "ERROR"
    },
    "freshness": {
      "mode": "max_loaded_at_within_window",
      "window": "PT24H",
      "compare": "landing_loaded_at",
      "severity": "WARNING"
    }
  },
  "owner": "banking-data-platform",
  "tags": [
    "master-data"
  ]
}
