      "name": "employee_id",
      "type": "bigint",
      "nullable": false,
      "key": true
    },
    {
      "name": "name",
      "type": "text",
      "nullable": true
    },
    {
      "name": "branch_id",
      "type": "bigint",
      "nullable": true
    },
    {
      "name": "role",
      "type": "text",
      "nullable": true
    },
    {
      "name": "hire_date",
      "type": "date",
      "nullable": true
    },
    {
      "name": "salary",
      "type": "numeric(18,2)",
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "timestamptz",
      "nullable": true
    }
  ],
  "quality": {
    "row_count": {
      "mode": "source_vs_landed_exact",
