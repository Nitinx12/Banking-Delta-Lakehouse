{
  "contract_version": 1,
  "name": "employees",
  "description": "MySQL employee master. Full load.",
  "source": "mysql_source",
  "source_schema": "banking_core_db",
  "source_table": "employees",
  "target_schema": "raw",
  "target_table": "employees",
  "business_key": [
