# Airflow environment template. Copy to .env.airflow and fill every value.
# The real .env.airflow is git-ignored and never copied into an image.
#
# Generate the secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Airflow image / build ---------------------------------------------------
AIRFLOW_VERSION=3.3.2
PYTHON_VERSION=3.13
AIRFLOW_IMAGE_TAG=local
GIT_SHA=unknown

# --- Airflow metadata DB (postgres, own container) --------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow_db

# --- Celery broker -----------------------------------------------------------
REDIS_PASSWORD=change_me

# --- Admin user (created by airflow-init) -----------------------------------
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_BASE_URL=http://localhost:8080

# --- Airflow secrets (generate unique values) --------------------------------
AIRFLOW__CORE__FERNET_KEY=generate_with_fernet
AIRFLOW__API_AUTH__JWT_SECRET=generate_random_secret
AIRFLOW__API__SECRET_KEY=generate_random_secret

# --- Schedule / timezone -----------------------------------------------------
BANKING_DAG_SCHEDULE=0 2 * * *
TIMEZONE=Asia/Kolkata

# --- Alerts (same SMTP_* the pipeline already uses) --------------------------
ALERT_EMAIL_TO=alerts@example.com
ALERT_EMAIL_FROM=alerts@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_STARTTLS=true
SMTP_SSL=false
ALERT_SUBJECT_PREFIX=[banking-delta]
ALERT_ON_TASK_FAILURE=true

# --- Watchdog thresholds -----------------------------------------------------
WATCHDOG_MAX_AGE_HOURS=30
WATCHDOG_STUCK_HOURS=5

# --- Warehouse / sources (reachable from the worker container) ---------------
# Host services from a container: use host.docker.internal (dev) or the real host.
#
# V6 (open): .env.example says banking_warehouse, but sql/scripts/* guard on
# current_database() = 'banking_delta'. Confirm the real name with the owner
# before go-live; banking_delta is used here to match the SQL guards.
PG_HOST=host.docker.internal
PG_PORT=5432
PG_DB=banking_delta
PG_USER=postgres
PG_PASS=change_me

MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=change_me
MYSQL_PASSWORD=change_me
MYSQL_DB=change_me

MONGO_URI=mongodb://change_me@host.docker.internal:27017/

DATABRICKS_HOST=change_me.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/change_me
DATABRICKS_TOKEN=change_me
DATABRICKS_CATALOG=main

# --- Parallelism / Spark memory (fit the sum into Docker Desktop's VM) -------
WORKER_CONCURRENCY=4
SPARK_DRIVER_MEMORY=2g
EXTRACT_SPARK_DRIVER_MEMORY=1g
SPARK_UI_ENABLED=false
SPARK_JARS_PACKAGES=

# --- Reporting (daily PDF report) -----------------------------------------
REPORT_ENABLED=true
REPORT_OUTPUT_DIR=reports/output
REPORT_TIMEZONE=Asia/Kolkata
REPORT_RETENTION_DAYS=30
REPORT_MAX_ATTACH_MB=10
REPORT_EMAIL_TO=
REPORT_TREND_RUNS=14
