#!/usr/bin/env bash
# .githooks/commit-msg — local Conventional Commits guard (mirrors commitlint.yml + pre-commit)
# Enable with: git config core.hooksPath .githooks
set -euo pipefail
msg=$(head -n1 "$1" | tr -d '\r')
pattern='^(feat|fix|docs|chore|refactor|test|ci|build|perf|style|revert)(\(.+\))?: .+'
if ! echo "$msg" | grep -Eq "$pattern"; then
  echo "✖ commit message does not match Conventional Commits" >&2
  echo "  got:      $msg" >&2
  echo "  expected: <type>(scope): <summary>" >&2
  echo "  types:    feat, fix, docs, chore, refactor, test, ci, build, perf, style, revert" >&2
  echo "  example:  feat(extract): fallback to append-only when no unique index" >&2
  exit 1
fi
# subject length <=72 (AGENTS.md says <=50, keep 72 as hard cap for body-aware tools)
if [ ${#msg} -gt 72 ]; then
  echo "✖ subject too long (${#msg} > 72): $msg" >&2
  exit 1
fi
