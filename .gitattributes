# ==========================
# Line endings: normalize to LF in the repo, LF on checkout
# Windows host (tasks.bat) and Linux CI/Docker must agree
# ==========================
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Always LF (explicit, so editors and tools never guess)
*.sh      text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.R       text eol=lf
*.r       text eol=lf
*.Rmd     text eol=lf
*.tex     text eol=lf
*.j2      text eol=lf
*.jinja   text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.json    text eol=lf
*.ipynb   text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
Makefile  text eol=lf
Dockerfile* text eol=lf
.env.example text eol=lf
.githooks/* text eol=lf

# ==========================
# Binary: never diff, never normalize
# ==========================
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.parquet binary
*.jar     binary
*.zip     binary
*.gz      binary
*.pptx    binary
*.xlsx    binary

# ==========================
# Linguist: keep GitHub language stats honest
# ==========================
# Notebooks are exploration/docs, not the product. Excluding them stops
# "Jupyter Notebook" from dominating the language bar.
*.ipynb       linguist-documentation
notebooks/**  linguist-documentation

# Lockfiles and generated artifacts
uv.lock       linguist-generated
*.min.js      linguist-generated
*.min.css     linguist-generated

# Rendered report output / screenshots are not source
assets/**     linguist-documentation
reports/**/*.pdf linguist-generated

# ==========================
# Diff behaviour
# ==========================
*.py   diff=python
*.md   diff=markdown
*.tex  diff=tex
*.sh   diff=bash
uv.lock -diff
